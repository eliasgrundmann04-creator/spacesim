{
  "name": "space-sim",
  "private": true,
  "version": "0.4.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:frames && npm run test:nav && npm run test:warp && npm run test:pace && npm run test:orbit && npm run test:orientation && npm run test:drag && npm run test:glide && npm run test:feel && npm run test:throughput",
    "test:frames": "node --experimental-strip-types --import ./tools/register-ts.mjs tools/test-frames.ts",
    "test:warp": "node --experimental-strip-types --import ./tools/register-ts.mjs tools/test-warp.ts",
    "test:pace": "node --experimental-strip-types --import ./tools/register-ts.mjs tools/test-pace.ts",
    "test:nav": "node --experimental-strip-types --import ./tools/register-ts.mjs tools/test-nav.ts",
    "test:orbit": "node --experimental-strip-types --import ./tools/register-ts.mjs tools/test-orbit.ts",
    "test:orientation": "node --experimental-strip-types --import ./tools/register-ts.mjs tools/test-orientation.ts",
    "test:drag": "node --experimental-strip-types --import ./tools/register-ts.mjs tools/test-drag.ts",
    "test:glide": "node --experimental-strip-types --import ./tools/register-ts.mjs tools/test-glide.ts",
    "test:feel": "node --experimental-strip-types --import ./tools/register-ts.mjs tools/test-feel.ts",
    "test:throughput": "node --experimental-strip-types --import ./tools/register-ts.mjs tools/test-throughput.ts",
    "contracts": "node tools/contracts.mjs",
    "check": "npm run typecheck && npm test && node tools/contracts.mjs --check && vite build"
  },
  "dependencies": {
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "typescript": "^5.5.4",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
